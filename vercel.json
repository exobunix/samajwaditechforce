{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/_expo/static/:path*",
      "destination": "/_expo/static/:path*"
    },
    {
      "source": "/assets/:path*",
      "destination": "/assets/:path*"
    },
    {
      "source": "/favicon.ico",
      "destination": "/favicon.ico"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}